# ============================================================
# 短剧工厂（short-video-factory）本地配置模板
#   1) 复制为 .env：cp .env.example .env
#      （.env 已被 .gitignore 忽略，不会入库；本文件是占位符，可提交）
#   2) 按需修改下面的项；不写的用代码默认值（见 config/settings.py）
#   3) 没有 DeepSeek key 也能跑：把 TEXT_MODEL_PROVIDER 改成 ollama / vllm
# ============================================================

# --- agent / 文本模型（默认 DeepSeek V4.1 Flash）---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TEXT_MODEL_PROVIDER=deepseek            # deepseek | ollama | vllm | kimi | custom
# DEEPSEEK_BASE=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-flash

# --- 依赖服务地址（按你的部署改）---
# COMFY_BASE=http://localhost:8188         # ComfyUI：MiniMax H3 逐镜渲染
# QWEN_IMAGE_URL=http://172.19.0.3:8601    # Qwen-Image 2.1：定妆 / 场景 / 首帧
# VISION_MODEL_BASE=http://172.19.0.2:11434/v1  # 质检视觉模型（ollama）
# VISION_MODEL_NAME=gemma3:4b
# OPENJEV_BASE=http://localhost:8091/v1    # 可选：本地决策引擎

# --- 运行参数 ---
# SVF_PORT=8600
# SVF_DATA_DIR=./data
# SVF_MAX_REPAIRS=2
# SVF_RENDER_TIMEOUT=7200

# --- 使用本地模型跑（不依赖云端 key）---
# TEXT_MODEL_PROVIDER=ollama
# TEXT_MODEL_BASE=http://172.19.0.2:11434/v1
# TEXT_MODEL_NAME=gemma3:4b
